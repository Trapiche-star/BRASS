    \uACC4\uACE1\uC5D0 \uCD94\uB77D\uD55C \uACE0\uB3C4\uC758 \uC720\uC0B0, '\uC774\uCE74\uB8E8\uC2A4
    \uD638'\uB97C \uC870\uC0AC\uD558\uC5EC \uD575\uC2EC \uB3D9\uB825\uC6D0\uC744
    \uD68C\uC218\uD574\uC57C \uD569\uB2C8\uB2E4.\r\n\uBE44\uD589\uC120\uC758 \uC794\uD574
    \uADFC\uCC98\uB97C \uBC30\uD68C\uD558\uB294 \uD0DC\uC5FD \uBAAC\uC2A4\uD130\uB4E4\uC744
    \uC870\uC2EC\uD558\uC2ED\uC2DC\uC624.\n"
